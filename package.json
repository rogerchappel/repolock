{
  "name": "@rogerchappel/repolock",
  "version": "0.1.0",
  "description": "Local-first repository policy snapshot and verify CLI.",
  "homepage": "https://github.com/rogerchappel/repolock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/repolock.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/repolock/issues"
  },
  "type": "module",
  "bin": {
    "repolock": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "npm run build && node dist/cli.js snapshot fixtures/basic-repo --output .tmp/smoke && node dist/cli.js verify fixtures/basic-repo --snapshot .tmp/smoke/repolock.snapshot.json",
    "example:smoke": "bash scripts/check-snapshot-example.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run build && npm run smoke && npm run example:smoke && npm run package:smoke"
  },
  "keywords": [
    "repository",
    "policy",
    "snapshot",
    "cli",
    "local-first",
    "agents"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
